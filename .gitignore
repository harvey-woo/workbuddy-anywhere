# Dependencies
node_modules/

# Build output
out/
ui-dist/
media/ui-dist/
# Scoped to the dsh plugin's bundle output. Do NOT widen this to a bare `lib/`:
# that also matches `packages/core/ui/src/lib/`, which is SOURCE (i18n/theme
# live there) — and because those files were never committed, ignoring them
# hides them from `git status` entirely, so a commit silently drops them.
packages/dsh/lib/
*.vsix
# scratch tree used by `yarn verify:release` to prove the packed tarball
# installs without the private @wbaw/core
packages/dsh/.verify-release/
# electron-builder outputs (per-platform installers)
packages/desktop/dist/
packages/desktop/win-unpacked/
packages/desktop/mac-arm64/
# stray esbuild artifact from a wrong-output build
packages/desktop/main.js

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# macOS
.DS_Store

# Bundled release artifacts (distributed out-of-band, not via git).
# Keep them on disk; the release zip is the actual delivery artifact.
release-*/
workbuddy-anywhere-*.zip
