{
  "name": "@wbaw/dsh-workbuddy",
  "version": "0.8.2",
  "description": "WorkBuddy Anywhere for DeepSeek Harness: use WorkBuddy models in dsh chat, with the shared multi-account management page served inside dsh Settings.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**",
    "client.js",
    "cordis.patch.yml",
    "ui-dist/**",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf lib ui-dist",
    "bundle": "node esbuild.mjs",
    "types": "tsc -p ./ --emitDeclarationOnly",
    "compile": "node esbuild.mjs && tsc -p ./ --emitDeclarationOnly && node scripts/stage-ui.mjs",
    "build": "yarn compile",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "verify:release": "node scripts/verify-tarball.mjs",
    "prepack": "WB_STRICT_UI=1 yarn compile"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^20.11.0",
    "@wbaw/core": "workspace:*",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
