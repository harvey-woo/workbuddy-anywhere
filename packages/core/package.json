{
  "name": "@wbaw/core",
  "version": "0.1.0",
  "private": true,
  "description": "WorkBuddy Anywhere core: auth, billing, model catalog, OpenAI-compatible chat engine, local HTTP API and web UI",
  "license": "MIT",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "files": [
    "out",
    "ui-dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean": "rm -rf out ui-dist",
    "ui:build": "vite build --config ui/vite.config.mts",
    "ui:dev": "vite --config ui/vite.config.mts",
    "build": "yarn compile && yarn ui:build",
    "test": "node scripts/test-protocols.cjs",
    "serve": "node out/cli.js serve"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.0",
    "vite": "^8.3.0",
    "vue": "^3.5.42"
  }
}
